# Скопируйте этот файл в .env и заполните

# Адрес сайта БЕЗ слэша в конце (нужен для возврата после оплаты)
BASE_URL=https://your-domain.ru
PORT=3000

# На сервере с HTTPS обязательно 1
COOKIE_SECURE=1

# Ключи из личного кабинета ЮKassa (Интеграция -> Ключи API)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Чеки по 54-ФЗ: поставьте 1, если у вас подключена онлайн-касса ЮKassa.
# Самозанятые чеки формируют сами в «Мой налог» — оставьте 0.
YOOKASSA_RECEIPT=0
YOOKASSA_VAT_CODE=1

# Цена одной подписки за 30 дней
PRICE_RUB=199.00

# ТОЛЬКО для проверки на своём компьютере: бесплатные подписки. На сервере НЕ включать!
DEV_FREE_ACCESS=0
